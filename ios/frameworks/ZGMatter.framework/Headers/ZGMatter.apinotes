Name: ZGMatter

Enumerators:
     # The Swift importer seems to get very confused about
     # ZGMTRWiFiNetworkDiagnosticsWiFiVersionType enum value naming depending on
     # which set of them is deprecated.  Give explicit Swift names to the
     # older-deprecated bits, so the importer does the same thing it used to do
     # with the bits that got deprecated more recently.
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionType80211a
      SwiftName: type80211a
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionType80211b
      SwiftName: type80211b
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionType80211g
      SwiftName: type80211g
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionType80211n
      SwiftName: type80211n
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionType80211ac
      SwiftName: type80211ac
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionType80211ax
      SwiftName: type80211ax

    # Make the names for ZGMTRWiFiNetworkDiagnosticsWiFiVersion all be
    # lowercase instead of having uppercase A and lowercase ax.
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionA
      SwiftName: a
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionB
      SwiftName: b
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionG
      SwiftName: g
    - Name: ZGMTRWiFiNetworkDiagnosticsWiFiVersionN
      SwiftName: n
