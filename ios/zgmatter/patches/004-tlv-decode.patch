     CHIP_ERROR Decode(chip::TLV::TLVReader & data)
     {
+        // Capture the raw TLV bytes before the decoded-object path advances the reader.
+        TLV::TLVReader rawTLVReader;
+        rawTLVReader.Init(data);
+        size_t bufferLen = rawTLVReader.GetRemainingLength() + rawTLVReader.GetLengthRead();
+        std::unique_ptr<uint8_t[]> buffer = std::unique_ptr<uint8_t[]>(new uint8_t[bufferLen]);
+        TLV::TLVWriter writer;
+        writer.Init(buffer.get(), bufferLen);
+        CHIP_ERROR err = writer.CopyElement(TLV::AnonymousTag(), rawTLVReader);
+        if (err != CHIP_NO_ERROR) {
+            return err;
+        }
+        size_t size = writer.GetLengthWritten();
+        NSData * tlvData = [NSData dataWithBytes:buffer.get() length:size];
+
         decodedObj = MTRDecodeDataValueDictionaryFromCHIPTLV(&data);
         if (decodedObj == nil) {
             MTR_LOG_ERROR("Error: Failed to get value from TLV data for attribute reading response");
+            return CHIP_ERROR_DECODE_FAILED;
+        }
+        NSMutableDictionary * mutableDict = [decodedObj mutableCopy];
+        if (mutableDict == nil) {
+            MTR_LOG_ERROR("Error: decoded TLV value is not a dictionary, cannot inject raw TLV data");
+            return CHIP_ERROR_DECODE_FAILED;
         }
-        return (decodedObj) ? CHIP_NO_ERROR : CHIP_ERROR_DECODE_FAILED;
+        [mutableDict setObject:tlvData forKey:MTRTlvValueType];
+        decodedObj = mutableDict;
+        return CHIP_NO_ERROR;
     }
 
