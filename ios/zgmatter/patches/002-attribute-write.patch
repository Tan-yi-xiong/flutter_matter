+- (void)writeAttributeRequests:(NSArray<MTRAttributeWriteRequest *> * _Nullable)attributePaths
+                   timedWriteTimeout:(NSNumber * _Nullable)timeoutMs
+                   imTimeoutMs:(NSNumber * _Nullable)imTimeoutMs
+                         queue:(dispatch_queue_t)queue
+                          completion:(MTRDeviceResponseHandler)completion
+{
+    auto * bridge = new MTRDataValueDictionaryCallbackBridge(queue, completion,
+        ^(ExchangeManager & exchangeManager, const SessionHandle & session, MTRDataValueDictionaryCallback successCb,
+            MTRErrorCallback failureCb, MTRCallbackBridgeBase * bridge) {
+            auto onSuccessCb = [successCb, bridge](const app::ConcreteAttributePath & attribPath) {
+                auto resultArray = @[ @ { MTRAttributePathKey : [[MTRAttributePath alloc] initWithPath:attribPath] } ];
+                successCb(bridge, resultArray);
+            };
+
+            auto onFailureCb = [failureCb, bridge](
+                                   const app::ConcreteAttributePath * attribPath, CHIP_ERROR aError) { failureCb(bridge, aError); };
+
+            auto callback = Platform::MakeUnique<chip::Controller::WriteCallback>(onSuccessCb, onFailureCb, nullptr, session->IsGroupSession());
+            VerifyOrReturnError(callback != nullptr, CHIP_ERROR_NO_MEMORY);
+
+            auto writeClient = Platform::MakeUnique<app::WriteClient>(app::InteractionModelEngine::GetInstance()->GetExchangeManager(),
+                                                                      callback->GetChunkedCallback(), (timeoutMs == nil || [timeoutMs isEqualToNumber:@(0)]) ? Optional<uint16_t>::Missing() : Optional<uint16_t>([timeoutMs unsignedShortValue]));
+            for (MTRAttributeWriteRequest * element in attributePaths) {
+                app::ConcreteDataAttributePath path(static_cast<EndpointId>([[element endpoint] intValue]),
+                    static_cast<ClusterId>([[element cluster] intValue]),
+                    static_cast<AttributeId>([[element attribute] intValue]), Optional<DataVersion>());
+                TLV::TLVReader reader;
+                reader.Init(AsByteSpan([element tlv]));
+                ReturnErrorOnFailure(reader.Next());
+                CHIP_ERROR err = writeClient->PutPreencodedAttribute(path, reader);
+                if (err != CHIP_NO_ERROR) {
+                    writeClient.release();
+                    callback.release();
+                    return err;
+                }
+            }
+
+            NSInteger imTimeout = imTimeoutMs == nil ? 0 : [imTimeoutMs intValue];
+            ReturnErrorOnFailure(writeClient->SendWriteRequest(session,
+                imTimeout != 0 ? System::Clock::Milliseconds32(imTimeout) : System::Clock::kZero));
+            writeClient.release();
+            callback.release();
+            return CHIP_NO_ERROR;
+        });
+    std::move(*bridge).DispatchAction(self);
+}
