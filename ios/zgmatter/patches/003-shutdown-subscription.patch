 #import <memory>
 
+@interface MTRDeviceController_Concrete (MTRBaseDevicePrivate)
+- (uint64_t)getFabricIndex;
+- (BOOL)syncRunOnWorkQueueWithBoolReturnValue:(BOOL (^)(void))block error:(NSError * __autoreleasing *)error;
+@end
+
+
+
 using namespace chip;
 using namespace chip::app;
 using namespace chip::Protocols::InteractionModel;
@@ -2291,9 +2298,29 @@
 - (NSString *)description
 {
     return [NSString
         stringWithFormat:@"<%@: %p, node: %016llX-%016llX (%llu)>", NSStringFromClass(self.class), self, _deviceController.compressedFabricID.unsignedLongLongValue, _nodeID, _nodeID];
 }
 
+- (BOOL)shutdownSubscription:(nonnull NSNumber *)subscriptionId scopedNodeId:(nonnull NSNumber *)scopedNodeId
+{
+    __block BOOL result = NO;
+    auto * concreteController = self.concreteController;
+    if (concreteController == nil) {
+        MTR_LOG_ERROR("Unable to shutdown subscription: no concrete controller");
+        return NO;
+    }
+
+    [concreteController syncRunOnWorkQueueWithBoolReturnValue:^BOOL() {
+        CHIP_ERROR err = InteractionModelEngine::GetInstance()->ShutdownSubscription(
+            chip::ScopedNodeId(static_cast<chip::NodeId>([scopedNodeId unsignedLongLongValue]),
+                static_cast<chip::FabricIndex>([concreteController getFabricIndex])),
+            [subscriptionId unsignedIntValue]);
+        result = (err == CHIP_NO_ERROR);
+        return result;
+    } error:nil];
+    return result;
+}
+
 @end
 
