+// ZG extension: decodable type that accepts pre-encoded command-field TLV
+// bytes (NSData) instead of a data-value dictionary.
+class MTRDataValueNSDataDecodableType {
+public:
+    MTRDataValueNSDataDecodableType()
+        : decodedObj(nil)
+    {
+    }
+    MTRDataValueNSDataDecodableType(id obj)
+        : decodedObj(obj)
+    {
+    }
+
+    CHIP_ERROR Decode(chip::TLV::TLVReader & data)
+    {
+        return CHIP_ERROR_DECODE_FAILED;
+    }
+
+    CHIP_ERROR Encode(chip::TLV::TLVWriter & writer, chip::TLV::Tag tag) const
+    {
+        if (decodedObj == nil) {
+            return CHIP_ERROR_DECODE_FAILED;
+        }
+        TLV::TLVReader reader;
+        reader.Init(AsByteSpan(decodedObj));
+        ReturnErrorOnFailure(reader.Next());
+        return writer.CopyContainer(TLV::ContextTag(app::CommandDataIB::Tag::kFields), reader);
+    }
+
+    static constexpr bool kIsFabricScoped = false;
+
+    static bool MustUseTimedInvoke() { return false; }
+
+    NSData * _Nullable GetDecodedObject() const { return decodedObj; }
+
+private:
+    NSData * _Nullable decodedObj;
+};
